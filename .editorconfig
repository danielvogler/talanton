# Ruff governs Python. This is for everything it does not see: the workflows,
# the config examples, the Markdown that is most of this repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so trimming them edits the
# text rather than tidying it.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
